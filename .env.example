# Copy to .env and fill in. .env is gitignored — never commit a real key.
#   cp .env.example .env
JEV_API_KEY=

# Set JEV_LIVE=1 instead of a key when the Authorization header is injected by a proxy
# or gateway (for example a Claude Code cloud environment API credential). Without it,
# a missing key silently falls back to the built-in mock.
# JEV_LIVE=1

# Optional overrides.
# JEV_ENDPOINT=https://api.typesafe.ai/v1/systemone
# JEV_MODEL=jev-latest
# JEV_DEBUG=1
